// Dev — day-to-day development. Debug-quality codegen.

#include "../Configs/Shared.xcconfig"

APP_ENVIRONMENT_NAME = Dev
// Composed into PRODUCT_BUNDLE_IDENTIFIER by the app target in
// Project.swift, which must set the id itself (a target setting
// outranks this xcconfig).
APP_BUNDLE_ID_SUFFIX = .dev
INFOPLIST_KEY_CFBundleDisplayName = TMDB Dev
// Consumed by the app target as ASSETCATALOG_COMPILER_APPICON_NAME.
APP_ICON_NAME = AppIcon-Dev

SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
