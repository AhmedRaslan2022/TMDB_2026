// Live — App Store builds. Release-quality codegen.

#include "../Configs/Shared.xcconfig"

APP_ENVIRONMENT_NAME = Live
// Composed into PRODUCT_BUNDLE_IDENTIFIER by the app target in
// Project.swift, which must set the id itself (a target setting
// outranks this xcconfig).
APP_BUNDLE_ID_SUFFIX = 
INFOPLIST_KEY_CFBundleDisplayName = TMDB
// Consumed by the app target as ASSETCATALOG_COMPILER_APPICON_NAME.
APP_ICON_NAME = AppIcon

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
ENABLE_NS_ASSERTIONS = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
MTL_ENABLE_DEBUG_INFO = NO
VALIDATE_PRODUCT = YES
