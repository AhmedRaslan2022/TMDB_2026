# SwiftFormat configuration — must agree with .swiftlint.yml

--swiftversion 6.0

# File discovery
--exclude **/.build,**/DerivedData,demo_app,Derived

# Rules
--enable isEmpty
--disable wrapMultilineStatementBraces

# Options
--indent 4
--maxwidth 130
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas always
--trimwhitespace always
--stripunusedargs closure-only
--self remove
--importgrouping testable-bottom
--dateformat dmy
--header "//\n//  {file}\n//  TMDB\n//\n//  Created by Ahmed Raslan on {created}.\n//"
