TMDB.xcworkspace/
.tuist-version
Tuist/.build/
Tuist/Dependencies/
# Synthesized Info.plists and bundle accessors, and the resolved SPM graph
# Tuist writes beside the workspace — all reproduced by `tuist generate`.
Derived/
.package.resolved
