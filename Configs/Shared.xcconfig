// Settings common to every environment. Env-specific files include this.

// Real secrets live in the git-ignored Secrets.xcconfig (copy from
// Secrets.example.xcconfig). Optional include so a fresh clone still parses.
#include? "Secrets.xcconfig"

IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Include every AppIcon set in the catalog (not just the primary) so the
// user-selectable alternate icons (AppIcon-Midnight / AppIcon-Sunset) are
// available to `setAlternateIconName`, on top of the per-environment primary.
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES

// App identity base — env files append their suffix / display name.
APP_BUNDLE_ID_BASE = com.rasslan.github.TMDB

// TMDB API — v3 endpoints, v4 bearer auth. `$()` breaks up `//` so it is
// not parsed as an xcconfig comment.
TMDB_API_BASE_URL = https:/$()/api.themoviedb.org/3
TMDB_IMAGE_BASE_URL = https:/$()/image.tmdb.org/t/p
